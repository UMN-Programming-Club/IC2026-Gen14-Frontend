# Mode mock: true = TANPA backend, memakai data contoh (untuk mengerjakan desain). Jangan true untuk contest sungguhan.
# Bila true, DOMJUDGE_URL boleh dikosongkan.
DOMJUDGE_MOCK=false
# Hanya untuk mode mock: before | unscheduled | running (bawaan) | ended. Mensimulasikan keadaan contest.
# Hanya mode mock: jam "DOMjudge" tertinggal sekian detik dari jam mesin (menguji selisih jam, mis. WSL).
DOMJUDGE_MOCK_CLOCK_LAG_SEC=0
DOMJUDGE_MOCK_SCENARIO=running
# Base URL DOMjudge (tanpa trailing slash, tanpa /api/v4)
DOMJUDGE_URL=http://localhost/domjudge
# id ATAU shortname contest di DOMjudge
# Opsional: akun DOMjudge ber-role "API reader" (tanpa tim). Hanya agar hitung mundur akurat SEBELUM
# contest dimulai (akun tim tidak boleh melihat waktu mulai). Tanpa ini: "Menunggu jadwal mulai".
DOMJUDGE_READER_USER=
DOMJUDGE_READER_PASSWORD=
DOMJUDGE_CONTEST_ID=IC2026
# Minimal 32 karakter. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
